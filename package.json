{
  "name": "cyphers-chat",
  "version": "1.0.0",
  "description": "Real-time chat application with AI assistant",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build-css": "npx @tailwindcss/cli -i ./client/input.css -o ./client/output.css",
    "db:setup": "node setup-database.js",
    "db:migrate": "node migrate-database.js",
    "db:test": "node test-database.js",
    "test": "node --test test/*.test.js",
    "watch-css": "npx @tailwindcss/cli -i ./client/input.css -o ./client/output.css --watch"
  },
  "keywords": [
    "chat",
    "realtime",
    "socket.io",
    "ai",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "4.0",
    "mongoose": "^8.8.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.14.1",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.1.0",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.5",
    "nodemon": "^3.0.1",
    "tailwindcss": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
