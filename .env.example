# Blockchain Provider
BSC_PROVIDER_URL=https://bsc-dataseed.binance.org/

# Database Configuration
# ======================
# For LOCAL development (default):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=final-db

# For HOSTING (cPanel/Shared):
# DB_HOST=localhost
# DB_USER=cpanel_username_dbuser        # e.g., khattab_cyphers
# DB_PASS=your_database_password
# DB_NAME=cpanel_username_dbname        # e.g., khattab_cyphers_db

# For VPS/Dedicated Server:
# DB_HOST=localhost                      # or server IP
# DB_USER=root
# DB_PASS=your_secure_password
# DB_NAME=final-db

# For Remote Database (AWS RDS, etc):
# DB_HOST=your-db.region.rds.amazonaws.com
# DB_USER=admin
# DB_PASS=your_password
# DB_NAME=cyphersdb

# JWT Configuration
JWT_SECRET_KEY=your_very_long_random_secret_key_here_at_least_64_characters_long
JWT_EXPIRES_IN=1d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# AI API Configuration (OpenRouter)
# Get your free API key from https://openrouter.ai
OPENROUTER_API_KEY=
# Keys remain on the server. Set AI_KEYLESS=false to disable fallback providers.
AI_KEYLESS=false
